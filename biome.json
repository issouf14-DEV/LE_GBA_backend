{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": true },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noConsole": { "level": "error", "options": { "allow": ["warn", "error"] } } }
    }
  },
  "overrides": [
    {
      "includes": ["src/server.js", "src/config/db.js", "scripts/**", "tests/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
  ],
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "es5" } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
