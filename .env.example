# Copiez ce fichier en .env et remplissez les valeurs. Ne commitez jamais le fichier .env.
NODE_ENV=development
PORT=5000

# Base MongoDB (Atlas ou locale)
MONGO_URI=mongodb://127.0.0.1:27017/le-gba

# Deux secrets différents d'au moins 32 caractères aléatoires.
# Pour en générer un : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Adresse(s) exacte(s) du frontend, séparées par des virgules
FRONTEND_URL=http://localhost:5173

# Nombre de proxys devant le serveur (0 en local, 2 derrière Vercel + Northflank)
TRUST_PROXY_HOPS=0

# Secret partagé avec le proxy Vercel (laisser vide en local). En production, même valeur
# que la variable PROXY_SECRET de Vercel : l'API refuse alors les appels directs au serveur.
PROXY_SECRET=

# Durée de validité du code « mot de passe oublié », en secondes (30 à 900).
# 30 s est très court : un email peut mettre plus longtemps à arriver. 300 (5 min) est plus confortable.
RESET_CODE_TTL_SECONDS=30

# Double authentification de l'équipe : clé qui chiffre les secrets 2FA en base (32 octets en
# base64). OBLIGATOIRE en production ; sans elle, l'équipe ne peut pas se connecter.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Ne la changez pas ensuite : les 2FA déjà configurées deviendraient illisibles.
TOTP_ENC_KEY=
# Nom affiché dans l'application d'authentification du téléphone
MFA_ISSUER=LE-GBA

# Bus d'événements (emails envoyés par le worker). Vide : bus en mémoire, worker intégré à l'API.
# En local avec Docker (voir docs/RABBITMQ.md) : amqp://gba:motdepasse@localhost:5672
# En production : l'URL amqps:// de l'addon, sur le service worker uniquement.
RABBITMQ_URL=
RABBITMQ_PREFETCH=10
RELAY_INTERVAL_MS=1000

# Notifications de l'application (cloche, temps réel SSE) : conservation en jours, et intervalle
# du ping du flux en ms (moins de 120 s : au-delà, le CDN Vercel coupe la connexion)
NOTIFICATION_TTL_DAYS=90
SSE_PING_MS=25000

# Premier compte administrateur, créé au démarrage s'il n'existe pas
# (12 caractères minimum avec lettres et chiffres, mot de passe non courant).
# Alternative plus sûre : laisser vide et lancer « npm run create-superadmin » (saisie masquée).
ADMIN_NAME=Administrateur
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Envoi des emails (facultatif) : Brevo par défaut (gratuit, 300/jour). EMAIL_FROM doit être
# une adresse vérifiée dans Brevo (Senders, domains & dedicated IPs > Senders)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=LE-GBA
# SENDGRID_API_KEY=   (seulement si EMAIL_PROVIDER=sendgrid)

# Journal d'audit : durée de conservation en jours (30 minimum, 365 par défaut)
AUDIT_RETENTION_DAYS=365

# Paiement en ligne de l'acompte par Mobile Money (CinetPay). Désactivé par défaut : none.
# fake : paiement simulé (démonstration, tests ; interdit en production). cinetpay : réel.
PAYMENT_PROVIDER=none
# Part du prix total payée en ligne, en % (1 à 100), arrondie au multiple de 5 FCFA supérieur
PAYMENT_DEPOSIT_PERCENT=30
# Obligatoires si PAYMENT_PROVIDER=cinetpay (espace marchand CinetPay > Intégrations)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Clé secrète : vérifie la signature (x-token) des notifications de paiement
CINETPAY_SECRET_KEY=
